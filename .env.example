# Copie para .env (nunca versione o .env) e ajuste.
# Em produção, o .env fica SÓ no servidor (modelo: .env.production.example).

# development (local) | staging | production | testing
APP_ENV=development

# Obrigatória em produção: mínimo de 32 caracteres aleatórios.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave-em-desenvolvimento-somente

# Origens permitidas no CORS, separadas por vírgula (URL do frontend).
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO

# Limite global por IP (formato do Flask-Limiter). Armazenamento em memória é por processo.
RATE_LIMIT_DEFAULT=120 per minute
RATE_LIMIT_STORAGE_URI=memory://

# Tamanho máximo do corpo da requisição, em bytes (padrão 1 MB).
MAX_CONTENT_LENGTH=1048576

# Swagger em /api/docs/swagger. Padrão: ligado fora de produção, desligado em produção.
# DOCS_ENABLED=false

# Prefixo público da API (padrão /api). Em produção a hospedagem monta a app nele.
# PUBLIC_BASE_PATH=/api
