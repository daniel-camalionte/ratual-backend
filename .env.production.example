# Produção (KingHost). Crie /apps_wsgi/api/.env NO SERVIDOR a partir deste modelo (chmod 600).
# Nunca versionar o .env nem colocar valores reais neste arquivo.

# Prefixo em que a KingHost monta a app (nome da aplicação no painel). Padrão /api.
PUBLIC_BASE_PATH=/api
APP_ENV=production

# Gere no servidor: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<chave-aleatoria-48+>

# Front e API ficam no mesmo domínio (mesma origem), mas mantemos a lista explícita.
CORS_ORIGINS=https://<dominio-canonico-do-front>

# Swagger em produção: DESLIGADO por padrão. Descomente SÓ para diagnóstico e REMOVA depois.
# DOCS_ENABLED=true

LOG_LEVEL=INFO

# --- Banco (MySQL/MariaDB) ---
MYSQL_DB_HOSTNAME=<host>
MYSQL_DB_USER=<usuario>
MYSQL_DB_PASSWORD=<senha>
MYSQL_DB_NAME=<banco>
MYSQL_DB_PORT=3306

# --- E-mail (código de acesso) ---
SMTP_HOST=smtp.kinghost.net
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=<conta>
SMTP_PASSWORD=<senha>
SMTP_FROM="Nome <conta@dominio>"

# --- Integrações ---
CRYPTO_KEY=<32 caracteres; a MESMA do Brain para ler os tokens migrados>
SCHEDULER_SECRET=<segredo da cron de coleta>
EWELINK_APPID=<appid>
EWELINK_APP_SECRET=<segredo>
EWELINK_REDIRECT_URL=https://<dominio>/api/v1/ewelink/callback
EWELINK_REGION=us
EWELINK_COLETA_INTERVALO_MIN=5
EZVIZ_APP_KEY=<key>
EZVIZ_APP_SECRET=<segredo>
EZVIZ_API_URL=https://open.ezvizlife.com
